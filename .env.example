# ─── Claude auth (set ONE of the two) ─────────────────────────────────────
# Option A (recommended if you have a Claude Pro/Max subscription):
# run `claude setup-token` on your machine and paste the resulting token.
# Usage is billed against your subscription, no extra API costs.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx
# Option B: pay-per-use API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ─── Home Assistant ───────────────────────────────────────────────────────
# Public URL of your HA instance (e.g. via a Cloudflare Tunnel). No trailing slash.
HA_BASE_URL=https://your-home-assistant.example.com
# Long-lived access token (Profile → Security → Long-lived access tokens).
HA_TOKEN=your-long-lived-access-token

# ─── Matrix: the BOT's own account ────────────────────────────────────────
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER=@yourbot:matrix.org
MATRIX_PASSWORD=the-bot-accounts-password

# ─── Matrix: allowed users ────────────────────────────────────────────────
# Comma-separated Matrix IDs the bot responds to and accepts invites from
# (you, family members, …). Everyone else is logged and ignored.
# (The singular MATRIX_ALLOWED_USER from v1 still works as a fallback.)
MATRIX_ALLOWED_USERS=@you:matrix.org,@partner:matrix.org

# ─── Optional ─────────────────────────────────────────────────────────────
# Override the model the agent uses (defaults to the Agent SDK's default).
# CLAUDE_MODEL=sonnet

# UI language for the bot's own messages (status, confirmations): de | en.
# The agent itself always mirrors the language you write in.
BOT_LANG=de

# Timezone for the daily briefing schedule.
TZ=Europe/Berlin

# ─── Proactive notifications (webhook) ────────────────────────────────────
# Home Assistant automations can POST {"message": "...", "smart": true|false}
# to http://<bot-host>:8321/notify with header "X-Token: <WEBHOOK_TOKEN>".
# smart=false posts the message verbatim; smart=true lets the agent
# investigate and phrase the push message itself.
# Leave WEBHOOK_TOKEN empty to disable the webhook entirely.
WEBHOOK_PORT=8321
WEBHOOK_TOKEN=
# Optional fixed room for webhook/briefing messages; defaults to the room
# you last wrote in.
# NOTIFY_ROOM=!roomid:matrix.org

# ─── Daily briefing ───────────────────────────────────────────────────────
# Local time (HH:MM, in TZ) for a daily agent-written briefing.
# Leave empty to disable.
BRIEFING_TIME=

# ─── Voice messages ───────────────────────────────────────────────────────
# Whisper model for transcribing Matrix voice messages: tiny | base | small |
# medium | large-v3, or "off" to disable. Bigger = better + slower (CPU).
WHISPER_MODEL=small

# ─── Signal (optional second channel) ─────────────────────────────────────
# Requires the signal-cli-rest-api sidecar:
#   docker compose --profile signal up -d
# then register/link the bot's phone number once (see README). Leave
# SIGNAL_NUMBER empty to keep Signal disabled.
# SIGNAL_API_URL=http://signal:8080
# SIGNAL_NUMBER=+491701234567
# Comma-separated phone numbers (E.164) the bot responds to:
# SIGNAL_ALLOWED_NUMBERS=+491700000001,+491700000002
# Optional: where webhook/briefing messages go on Signal — a phone number or
# "group.<id>" (group ids via GET /v1/groups/<SIGNAL_NUMBER>):
# SIGNAL_NOTIFY=+491700000001

# ─── Safety ───────────────────────────────────────────────────────────────
# true: destructive shell commands (rm, DELETE calls, HA restart/stop, backup
# deletion, …) require a yes/no (or 👍/👎) confirmation in the chat first.
# false: everything runs unattended (v1 behavior).
CONFIRM_DESTRUCTIVE=true
